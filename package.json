{
  "name": "comicrelief",
  "version": "0.5.0",
  "description": "A deterministic, governed humor presentation layer for software messages.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "bin": {
    "comicrelief": "bin/comicrelief.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.mjs",
    "check": "npm run build && npm test",
    "cli": "npm run build && node bin/comicrelief.mjs",
    "demo:build": "npm run build && node scripts/build-demo.mjs",
    "demo:serve": "npm run demo:build && node scripts/serve-demo.mjs",
    "example:console": "npm run build && node examples/console.mjs",
    "example:structured": "npm run build && node examples/structured.mjs",
    "example:pino": "npm run build && node examples/pino-like.mjs",
    "example:winston": "npm run build && node examples/winston-like.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MichaelWave369/ComicRelief.git"
  },
  "bugs": {
    "url": "https://github.com/MichaelWave369/ComicRelief/issues"
  },
  "homepage": "https://github.com/MichaelWave369/ComicRelief#readme",
  "keywords": [
    "humor",
    "errors",
    "logging",
    "pino",
    "winston",
    "cli",
    "catalog",
    "playground",
    "developer-experience",
    "typescript"
  ],
  "author": "MichaelWave369",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  }
}
